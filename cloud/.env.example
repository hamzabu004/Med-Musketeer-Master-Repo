# Copy with scripts/init-env.sh, which fills every secret with a random value.
# Never commit .env. Secrets are listed here without values.

# Published ports (bound to 127.0.0.1)
PROXY_HTTP_PUBLISHED_PORT=8080
API_PUBLISHED_PORT=8000
