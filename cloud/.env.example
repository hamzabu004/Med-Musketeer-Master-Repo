# Copy with scripts/init-env.sh, which fills every secret with a random value.
# Never commit .env. Secrets are listed here without values.

# Published ports (bound to 127.0.0.1)
PROXY_HTTP_PUBLISHED_PORT=8080
API_PUBLISHED_PORT=8000
EMQX_DASHBOARD_PUBLISHED_PORT=18083
EMQX_GATEWAY_PUBLISHED_PORT=8883
EMQX_INTERNAL_PUBLISHED_PORT=1883
# Address the gateway listener is published on; the public server uses 0.0.0.0
EMQX_GATEWAY_BIND_ADDRESS=127.0.0.1
# Addresses the HTTP services are published on; keep 127.0.0.1 on the public server (the proxy is the way in)
PROXY_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PUBLISHED_PORT=3000
# The API address built into the dashboard image (the `dashboard` compose profile)
DASHBOARD_API_URL=http://localhost:8000

# ZITADEL is reached at http://${ZITADEL_DOMAIN}:${PROXY_HTTP_PUBLISHED_PORT}
ZITADEL_DOMAIN=localhost

# Origins the dashboard runs on, comma-separated: its sign-in redirect URIs in ZITADEL and the
# origins the API allows (CORS). Applied on the next `up` (the zitadel-bootstrap job).
# All http (development) or all https, never both: http turns on ZITADEL's dev mode for the app.
DASHBOARD_ORIGINS=http://localhost:3000

# Public deployment (compose.public.yaml; see README, "Public deployment"). Uncomment and set:
# ACME_EMAIL=
# API_HOST=
# DASHBOARD_HOST=
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory   # for trials

# Secrets (generated)
POSTGRES_ADMIN_PASSWORD=
ZITADEL_DB_PASSWORD=
MM_MIGRATOR_PASSWORD=
MM_API_PASSWORD=
ZITADEL_MASTERKEY=
ZITADEL_ADMIN_PASSWORD=
LOGIN_SESSION_COOKIE_SECRET=
EMQX_DASHBOARD_PASSWORD=
EMQX_HOOK_SECRET=
EMQX_ADAPTER_PASSWORD=
EMQX_NODE_COOKIE=
EMQX_API_SECRET=
INGEST_SECRET=
