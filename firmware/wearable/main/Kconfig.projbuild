menu "MedMusketeer Wearable"

choice WEARABLE_MODE
    prompt "Path mode (compile-time selection)"
    default WEARABLE_MODE_FIXED

config WEARABLE_MODE_FIXED
    bool "Fixed path (local gateway)"

config WEARABLE_MODE_MOBILE
    bool "Mobile mode (placeholder)"

endchoice

config WEARABLE_OLED_SDA_GPIO
    int "SH1106 I2C SDA GPIO"
    range 0 48
    default 8

config WEARABLE_OLED_SCL_GPIO
    int "SH1106 I2C SCL GPIO"
    range 0 48
    default 9

config WEARABLE_OLED_I2C_ADDRESS
    hex "SH1106 I2C address"
    range 0x3C 0x3D
    default 0x3C

config WEARABLE_ALERT_BUTTON_GPIO
    int "Alert push button GPIO (active low, internal pull-up)"
    range 0 48
    default 4
    help
        A press publishes one alert with a synthetic ECG segment. It stands in for the on-device
        model until Iteration 5.

endmenu
